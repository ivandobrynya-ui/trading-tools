# Copy this file to .env (same folder) and fill it in. .env is git-ignored: keys never go to git.
# Without keys the bot runs against the built-in mock exchange.

EXCHANGE=bybit              # bybit | mock
BYBIT_ENV=testnet           # testnet | demo   (no mainnet in this build)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# shared secret that TradingView puts in the alert JSON, at least 16 characters
WEBHOOK_SECRET=

# risk
RISK_PCT=0.5                # default risk per trade, % of equity lost if the stop is hit
MAX_RISK_PCT=2              # signals asking for more are refused
LEVERAGE=3
MAX_LEVERAGE=10
DAILY_LOSS_PCT=3            # stop new entries after -3% from equity at 00:00 UTC (0 = off)
FLATTEN_ON_DAILY_LIMIT=true # also close open positions when the limit is hit
DEFAULT_SL_PCT=0            # 0 = a signal without a stop is refused
DEFAULT_TP_R=0              # 0 = no take profit unless the signal sends one
REVERSE=true                # opposite signal closes the position and opens the other way
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MAX_NOTIONAL=0              # cap on position value in USDT (0 = no cap)
FEE_RATE=0.00055            # taker fee used in sizing
RESYNC_SECONDS=60
